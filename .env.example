# Fill in the credentials for the selected environment. Keep this file private.
QBO_ENVIRONMENT=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/qbo/callback/

# Optional for a webhook receiver. Use the verifier token for the endpoint's environment.
QBO_WEBHOOK_VERIFIER_TOKEN=

# Set false only to test Intuit validation in the sandbox.
QBO_VALIDATE_FIELDS=true
# Optional company country: AU, CA, US, UK, or IN.
QBO_COUNTRY=
